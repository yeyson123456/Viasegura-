# VíaSegura IA — configuration template.
# Copy to .env and adjust. `docker compose up` also works WITHOUT a .env (defaults are built in).
# .env is git-ignored: never commit real secrets. In Azure, secrets live in Key Vault.

# --- API ---
API_ENV=local
API_LOG_LEVEL=INFO
API_PORT=8000
# Comma-separated origins allowed by CORS (driver PWA and dashboard dev servers).
API_CORS_ORIGINS=http://localhost:5173,http://localhost:5174
# Required by PATCH /incidents/{id} (dashboard "mark as resolved"). Use a long random value.
ADMIN_API_KEY=change-me

# --- MongoDB ---
# docker compose ignores this value and always uses mongodb://mongo:27017 (the service name).
# Running the API directly on your machine: mongodb://localhost:27017
# MongoDB Atlas: mongodb+srv://<user>:<password>@<cluster-host>/?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=viasegura
MONGODB_TIMEOUT_MS=3000
# Host port for the local MongoDB container (bound to 127.0.0.1 only).
MONGO_PORT=27017
# Raw reports are deleted this many days after they arrive (TTL index).
REPORTS_TTL_DAYS=30

# --- Consensus: confirmed when N distinct devices report the same type within R m and T min ---
CONSENSUS_MIN_DEVICES=3
CONSENSUS_RADIUS_M=30
CONSENSUS_WINDOW_MIN=60
# Device confidence below this is refused; device timestamps older than this many hours too.
MIN_REPORT_CONFIDENCE=0.25
REPORT_MAX_AGE_H=48

# --- Server-side re-detection (same ONNX model as the phone) ---
MODEL_PATH=../../ml/models/hazards.onnx
SERVER_CHECK_MIN_CONFIDENCE=0.15

# --- Storage (photos in Blob, events in Queue). Empty = local folder, no queue. ---
# compose points this at Azurite automatically; in Azure it comes from Key Vault.
AZURE_STORAGE_CONNECTION_STRING=
BLOB_CONTAINER=report-images
EVENTS_QUEUE=risk-events
